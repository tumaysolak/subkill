{
  "name": "subkill",
  "productName": "SubKill",
  "version": "1.0.0",
  "description": "Aboneliklerini yerel olarak takip et, gereksiz olanlari kes.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win zip",
    "dist:all": "electron-builder --mac dmg --win zip"
  },
  "license": "MIT",
  "dependencies": {
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.subkill.app",
    "productName": "SubKill",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["src/**/*", "ui/**/*", "package.json", "!node_modules/sql.js/dist/sql-wasm*"],
    "mac": {
      "category": "public.app-category.finance",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "identity": null,
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "dmg": { "title": "SubKill" }
  }
}
