{
  "name": "subkill",
  "productName": "SubKill",
  "version": "1.2.0",
  "description": "Aboneliklerini yerel olarak takip et, gereksiz olanlari kes.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win zip",
    "dist:all": "electron-builder --mac dmg --win zip",
    "test:e2e": "node test/e2e.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.2",
    "resedit": "^2.0.3",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.49.0"
  },
  "build": {
    "appId": "com.subkill.app",
    "productName": "SubKill",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json",
      "!node_modules/sql.js/dist/sql-wasm*",
      "!build/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "dmg": {
      "title": "SubKill"
    },
    "afterPack": "build/afterPack.js"
  }
}